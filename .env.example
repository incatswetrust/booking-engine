APP_NAME="Booking Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Platform Admin: how many days since last_activity_at before a user
# counts as "Inactive" (§64).
ACTIVE_USER_WINDOW_DAYS=30

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=booking_engine
DB_USERNAME=booking_engine
DB_PASSWORD=secret
# Host-side port mapping for docker-compose (change if 5432 is taken on your machine)
FORWARD_DB_PORT=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Host-side port mapping for docker-compose (change if 6379 is taken on your machine)
FORWARD_REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET=
# From `stripe listen --forward-to <host>/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Stripe Connect OAuth client ("ca_...") from
# https://dashboard.stripe.com/settings/connect/onboarding-options -- lets an
# organization connect its own Stripe account (§36-equivalent for payments).
STRIPE_CONNECT_CLIENT_ID=
# Separate webhook endpoint registered to receive events *from connected
# accounts* (Connect settings, not the main webhook endpoint above) --
# `stripe listen --forward-to <host>/api/v1/webhooks/stripe-connect --forward-connect-to <host>/api/v1/webhooks/stripe-connect`
STRIPE_CONNECT_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=

# OAuth2 client from https://console.cloud.google.com/apis/credentials,
# with the Calendar API enabled and this redirect URI registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/api/v1/calendar-connections/callback"

VITE_APP_NAME="${APP_NAME}"

L5_SWAGGER_CONST_HOST="${APP_URL}"
L5_SWAGGER_GENERATE_ALWAYS=true

# Empty DSN disables Sentry entirely (safe default for local dev)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Disabled by default (safe no-op locally): exporters are "null" and the SDK
# itself is off. To enable, set OTEL_SDK_DISABLED=false, point
# OTEL_EXPORTER_OTLP_ENDPOINT at a real collector, and switch the exporters
# below to "otlp".
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=null
OTEL_METRICS_EXPORTER=null
OTEL_LOGS_EXPORTER=null
OTEL_SERVICE_NAME="${APP_NAME}"
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
